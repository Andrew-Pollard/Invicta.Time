<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>10.0-all</AnalysisLevel>
    <!-- Required by the LibraryImport generator, which emits unsafe code; no unsafe code is written by hand. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Invicta</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Invicta.Time</PackageId>
    <Version>1.0.0-alpha.1</Version>
    <Authors>Andrew Pollard</Authors>
    <Copyright>© 2026 Andrew Pollard. All rights reserved.</Copyright>
    <Description>A System.TimeProvider whose timers use Windows high-resolution waitable timers (CREATE_WAITABLE_TIMER_HIGH_RESOLUTION) instead of the ~15.6 ms system clock tick.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>invicta time timeprovider timer highresolution windows</PackageTags>
    <PackageProjectUrl>https://github.com/Andrew-Pollard/Invicta.Time</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Andrew-Pollard/Invicta.Time</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Invicta.Time.Tests" />
  </ItemGroup>

</Project>
